PORT=3000
NODE_ENV=development


# ============================================================================
# DB General Configuration
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=dc_common_service
DB_LOGGING=false

# ============================================================================
# Integration Test Database Profile
# ============================================================================
# Export these values (or copy them into a local .env.test file) before running
# `npm run test:integration` against:
#   docker compose --profile test up -d db-test migrate-test seed-test
# DB_HOST=localhost
# DB_PORT=5433
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=dc_common_service_test
# NODE_ENV=test

# ============================================================================
# DB SSL Configuration
# ============================================================================
DB_SSL=false
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=/etc/postgres/certs/ca.crt

# ===========================================================================
# Swagger Configuration
# ===========================================================================
SWAGGER_ENABLED=true
SWAGGER_JSON_ENABLED=true

# ===========================================================================
# pg-boss Worker Configuration
# ===========================================================================
PG_BOSS_POLLING_INTERVAL_SECONDS=2
PG_BOSS_LOCAL_CONCURRENCY=2
PG_BOSS_WORKERS_ENABLED=true

# ===========================================================================
# Key Provider Configuration
# ===========================================================================
CONNECTOR_ENCRYPTION_KEYS_PATH='./config/encryption-keys.json'

# ===========================================================================
# Audit Configuration
# ===========================================================================
# Optional Nest interceptor for mutating HTTP routes not covered by domain producers.
AUDIT_AUTO_INTERCEPTOR_ENABLED=false
# Daily UTC cron for audit_log partition maintenance (pg-boss schedule).
AUDIT_PARTITION_CRON=0 3 * * *
AUDIT_PARTITION_MONTHS_AHEAD=3

# ===========================================================================
# Development Seed (IN-11)
# ===========================================================================
# Run `npm run seed` after migrations, or set SEED_ON_START=true to seed when
# the app boots (e.g. init-container / first-run docker compose).
SEED_ON_START=false

# Parsed as literal key=value — no shell expansion, so $VARS and ~ do not work.

PORT=3000
NODE_ENV=development


# ============================================================================
# DB General Configuration
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=dc_common_service
DB_LOGGING=false

# Connection pool (node-postgres). Bound explicitly rather than using the
# driver default of 10. A pod opens two independent pools — TypeORM's
# (DB_POOL_MAX) and pg-boss's (PGBOSS_POOL_MAX) — so its ceiling is the sum of
# the two. Size (DB_POOL_MAX + PGBOSS_POOL_MAX) x replicas, plus the worker and
# migration Job, against Postgres max_connections (see issue #156).
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
PGBOSS_POOL_MAX=5

# ============================================================================
# Integration Test Database Profile
# ============================================================================
# Export these values (or copy them into a local .env.test file) before running
# `npm run test:integration` against:
#   docker compose --profile test up -d db-test migrate-test seed-test
# DB_HOST=localhost
# DB_PORT=5433
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=dc_common_service_test
# NODE_ENV=test

# ============================================================================
# DB SSL Configuration
# ============================================================================
DB_SSL=false
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=/etc/postgres/certs/ca.crt

# ===========================================================================
# Swagger Configuration
# ===========================================================================
SWAGGER_ENABLED=true
SWAGGER_JSON_ENABLED=true

# ===========================================================================
# pg-boss Worker Configuration
# ===========================================================================
PG_BOSS_POLLING_INTERVAL_SECONDS=2
PG_BOSS_LOCAL_CONCURRENCY=2
PG_BOSS_WORKERS_ENABLED=true

# ===========================================================================
# Key Provider Configuration
# ===========================================================================
CONNECTOR_ENCRYPTION_KEYS_PATH='./config/encryption-keys.json'

# ===========================================================================
# Upstream Identity Federation Configuration (Keycloak)
# ===========================================================================
UPSTREAM_IDENTITY_FEDERATION_CONFIG_PATH='./config/upstream-identity-federation.json'

# ===========================================================================
# OIDC Provider Configuration (AU-01)
# ===========================================================================
# Public base URL the OIDC provider is mounted at, e.g. https://app.example.com/oidc
# Required in production; defaults to http://localhost:${PORT}/oidc in dev.
# Locally this is the Caddy front door (see caddy/Caddyfile). The dev seed
# also registers the UI's OIDC client with redirect URIs on this URL's origin,
# since the front door serves the SPA and /oidc on one origin.
OIDC_ISSUER=https://app.localhost/oidc

# Path to a JSON file containing the RS256 signing JWKS (private keys).
# If missing outside production, a development key is auto-generated and
# persisted to this path. Required to exist in production.
OIDC_KEYS_PATH='./config/oidc-keys.json'

# Comma-separated secrets used to sign oidc-provider's session/state cookies.
# The first key is used to sign new cookies; additional keys are accepted
# for verification during rotation. Required in production.
# OIDC_COOKIE_KEYS=change-me-1,change-me-2

# Token lifetimes (seconds). Defaults: 300 (5 min) / 28800 (8 hours).
# OIDC_REFRESH_TOKEN_TTL_SECONDS is the server-wide default only; an
# individual client can override it via the oauth_client
# refresh_token_ttl_seconds column (NULL there means "inherit this value").
OIDC_ACCESS_TOKEN_TTL_SECONDS=300
OIDC_REFRESH_TOKEN_TTL_SECONDS=28800
OIDC_REFRESH_TOKEN_ROTATION_ENABLED=true

# How long an interactive login stays valid (seconds). Defaults to
# OIDC_REFRESH_TOKEN_TTL_SECONDS so the two stay aligned. Set explicitly to
# let a browser session outlive (or expire ahead of) its refresh token.
# OIDC_SESSION_TTL_SECONDS=28800

# Lifetime of a Grant, the stored record of a user's consent to a client
# (seconds). Default: 1209600 (14 days). This is an upper bound on a refresh
# chain: the Grant is not re-saved when a refresh token rotates, so lowering
# it below the refresh token TTL will cut off otherwise-valid refreshes.
# OIDC_GRANT_TTL_SECONDS=1209600

# Maximum concurrent sessions per user. When a login would exceed this, the
# user's oldest session is revoked along with its grants and tokens. Set to 0
# to disable the limit. Default: 5.
# Has no effect until AU-02 wires the interactive login call site.
# OIDC_MAX_CONCURRENT_SESSIONS=5

# Comma-separated server-wide scope allowlist. Every scope value granted to
# an oauth_client (OAuthClient.scopes) must appear here or that client will
# fail to load with an invalid_client_metadata error. 'openid' and
# 'offline_access' are always included automatically; 'offline_access' is
# what makes oidc-provider register the refresh_token grant at all, so
# removing it would silently disable refresh tokens. Defaults to the scopes
# used in the OAuthClient API examples.
# OIDC_SCOPES=tenants:admin,credentials:offer,credentials:verify,connections:manage,logs:read,audit:read

# Comma-separated grant types an oauth_client may be registered with.
# Only grants the provider can serve are accepted (client_credentials,
# refresh_token, authorization_code); anything else fails at startup rather
# than producing clients that break at the authorize endpoint.
# Note this gates the OAuthClient *API*, not the provider: the seeded UI SPA
# client (dtsc-ui, authorization_code + refresh_token) is written straight to
# the table and is unaffected by this list.
# OIDC_GRANT_TYPES=client_credentials

# ===========================================================================
# JWT Validation (AU-03)
# ===========================================================================
# JWKS cache TTL in seconds for JwtGuard verification against GET /oidc/jwks.
# JWT_JWKS_CACHE_TTL_SECONDS=300

# Upper bound (ms) for fetching JWKS. Defaults to 5000.
# JWT_JWKS_FETCH_TIMEOUT_MS=5000

# Optional override for the JWKS URL fetched by JwtGuard. Defaults to
# ${OIDC_ISSUER}/jwks when unset.
# JWT_JWKS_URI=http://localhost:3000/oidc/jwks

# Expected JWT audience for API access tokens (JwtGuard) and the default
# RFC 8707 resource indicator used when clients omit `resource` at /oidc/token.
# Must be an absolute URI without a fragment. Defaults to
# https://digital-trust-common-service (stable across environments; not the
# OIDC issuer URL). The AU-01 interim of aud = OIDC_ISSUER is no longer used.
# JWT_AUDIENCE=https://digital-trust-common-service

# Extra RFC 8707 resource indicators oidc-provider may mint JWTs for
# (downstream gateways). Those tokens are NOT accepted by JwtGuard.
# Example for OB-07 Loki: JWT_ADDITIONAL_AUDIENCES=https://loki-gateway
# JWT_ADDITIONAL_AUDIENCES=

# ===========================================================================
# Audit Configuration
# ===========================================================================
# Optional Nest interceptor for mutating HTTP routes not covered by domain producers.
AUDIT_AUTO_INTERCEPTOR_ENABLED=false
# Daily UTC cron for audit_log partition maintenance (pg-boss schedule).
AUDIT_PARTITION_CRON=0 3 * * *
AUDIT_PARTITION_MONTHS_AHEAD=3

# ===========================================================================
# Adapter Registry (CA-02)
# ===========================================================================
# Platform-admin escape hatch allowing a request to override which agent adapter
# handles an operation, bypassing the tenant's configured connector. Keep off
# outside debugging: it lets a platform admin route a tenant's credential
# operation through a different backend agent.
ADAPTER_OVERRIDE_ENABLED=false

# ===========================================================================
# Development Seed (IN-11)
# ===========================================================================
# Run `npm run seed` after migrations, or set SEED_ON_START=true to seed when
# the app boots (e.g. init-container / first-run docker compose).
# Blocked when NODE_ENV=production unless SEED_ALLOW_PRODUCTION=true.
SEED_ON_START=false
# SEED_ALLOW_PRODUCTION=true
# Secret for the seeded confidential clients. Where unset (hosted previews),
# each gets a random secret that nothing in the repository can replay.
# Set locally only if you need to mint tokens for seeded confidential clients.
SEED_CLIENT_SECRET=

# ===========================================================================
# OpenTelemetry
# ===========================================================================
# Master switch for the OTel SDK, read before NestJS boots. Off by default:
# with it on, the app opens exporter connections at startup, which is wasted
# work and log noise in tests, CI, and any session where you are not looking
# at telemetry. Turn it on together with the local stack:
#   docker compose --profile obs up -d lgtm
# Deployed environments set it through the Helm chart, not this file.
OTEL_ENABLED=false

# JSON stdout log threshold. Deployed environments set it through the Helm
# ConfigMap; this local value mirrors the application default.
LOG_LEVEL=info

# Identifies this service in Grafana. The worker will report separately under
# its own name once it exists.
OTEL_SERVICE_NAME=digital-trust-common-service

# Where telemetry is sent. This default suits the standard workflow (the API
# on the host via `npm run start:dev`); the compose `app` service overrides it
# to http://lgtm:4318, so neither workflow needs an edit here. Deployed, this
# is Alloy at http://monitoring-collector-alloy:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# http/protobuf on 4318 rather than gRPC on 4317. Alloy accepts both; this is
# the platform standard. Changing it means changing the endpoint port to match
# — an HTTP client posting to the gRPC port fails silently.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp

# Local only — deliberately absent from the Helm values. In OpenShift, logs
# go to stdout and Alloy ships them to Loki. There is no Alloy locally, so the
# SDK pushes them straight to the LGTM collector instead. Either way the SDK
# attaches trace context, so logs and traces link up in Grafana. Only produces
# anything once structured logging lands (#102).
OTEL_LOGS_EXPORTER=otlp

# Trust the local Caddy CA (export it first — see docs/DEVELOPER.md).
NODE_EXTRA_CA_CERTS=./caddy/root.crt

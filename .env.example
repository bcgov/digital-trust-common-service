PORT=3000
NODE_ENV=development


# ============================================================================
# DB General Configuration
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=dc_common_service
DB_LOGGING=false

# Connection pool (node-postgres). Bound explicitly rather than using the
# driver default of 10. A pod opens two independent pools — TypeORM's
# (DB_POOL_MAX) and pg-boss's (PGBOSS_POOL_MAX) — so its ceiling is the sum of
# the two. Size (DB_POOL_MAX + PGBOSS_POOL_MAX) x replicas, plus the worker and
# migration Job, against Postgres max_connections (see issue #156).
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
PGBOSS_POOL_MAX=5

# ============================================================================
# Integration Test Database Profile
# ============================================================================
# Export these values (or copy them into a local .env.test file) before running
# `npm run test:integration` against:
#   docker compose --profile test up -d db-test migrate-test seed-test
# DB_HOST=localhost
# DB_PORT=5433
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=dc_common_service_test
# NODE_ENV=test

# ============================================================================
# DB SSL Configuration
# ============================================================================
DB_SSL=false
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=/etc/postgres/certs/ca.crt

# ===========================================================================
# Swagger Configuration
# ===========================================================================
SWAGGER_ENABLED=true
SWAGGER_JSON_ENABLED=true

# ===========================================================================
# pg-boss Worker Configuration
# ===========================================================================
PG_BOSS_POLLING_INTERVAL_SECONDS=2
PG_BOSS_LOCAL_CONCURRENCY=2
PG_BOSS_WORKERS_ENABLED=true

# ===========================================================================
# Key Provider Configuration
# ===========================================================================
CONNECTOR_ENCRYPTION_KEYS_PATH='./config/encryption-keys.json'

# ===========================================================================
# OIDC Provider Configuration (AU-01)
# ===========================================================================
# Public base URL the OIDC provider is mounted at, e.g. https://app.example.com/oidc
# Required in production; defaults to http://localhost:${PORT}/oidc in dev.
# OIDC_ISSUER=http://localhost:3000/oidc

# Path to a JSON file containing the RS256 signing JWKS (private keys).
# If missing outside production, a development key is auto-generated and
# persisted to this path. Required to exist in production.
OIDC_KEYS_PATH='./config/oidc-keys.json'

# Comma-separated secrets used to sign oidc-provider's session/state cookies.
# The first key is used to sign new cookies; additional keys are accepted
# for verification during rotation. Required in production.
# OIDC_COOKIE_KEYS=change-me-1,change-me-2

# Token lifetimes (seconds). Defaults: 300 (5 min) / 28800 (8 hours).
OIDC_ACCESS_TOKEN_TTL_SECONDS=300
OIDC_REFRESH_TOKEN_TTL_SECONDS=28800
OIDC_REFRESH_TOKEN_ROTATION_ENABLED=true

# Comma-separated server-wide scope allowlist. Every scope value granted to
# an oauth_client (OAuthClient.scopes) must appear here or that client will
# fail to load with an invalid_client_metadata error. 'openid' is always
# included automatically. Defaults to the scopes used in the OAuthClient API
# examples.
# OIDC_SCOPES=tenants:admin,credentials:offer,credentials:verify,connections:manage,logs:read,audit:read

# Comma-separated grant types an oauth_client may be registered with.
# Only grants the provider can serve are accepted (client_credentials,
# refresh_token); anything else fails at startup rather than producing
# clients that break at the authorize endpoint.
# OIDC_GRANT_TYPES=client_credentials

# ===========================================================================
# JWT Validation (AU-03)
# ===========================================================================
# JWKS cache TTL in seconds for JwtGuard verification against GET /oidc/jwks.
# JWT_JWKS_CACHE_TTL_SECONDS=300

# Upper bound (ms) for fetching JWKS. Defaults to 5000.
# JWT_JWKS_FETCH_TIMEOUT_MS=5000

# Optional override for the JWKS URL fetched by JwtGuard. Defaults to
# ${OIDC_ISSUER}/jwks when unset.
# JWT_JWKS_URI=http://localhost:3000/oidc/jwks

# Expected JWT audience for JwtGuard. Defaults to OIDC_ISSUER when unset.
# Use this when tokens carry a resource-indicator aud distinct from the issuer.
# JWT_AUDIENCE=http://localhost:3000/oidc

# ===========================================================================
# Audit Configuration
# ===========================================================================
# Optional Nest interceptor for mutating HTTP routes not covered by domain producers.
AUDIT_AUTO_INTERCEPTOR_ENABLED=false
# Daily UTC cron for audit_log partition maintenance (pg-boss schedule).
AUDIT_PARTITION_CRON=0 3 * * *
AUDIT_PARTITION_MONTHS_AHEAD=3

# ===========================================================================
# Development Seed (IN-11)
# ===========================================================================
# Run `npm run seed` after migrations, or set SEED_ON_START=true to seed when
# the app boots (e.g. init-container / first-run docker compose).
# Blocked when NODE_ENV=production unless SEED_ALLOW_PRODUCTION=true.
SEED_ON_START=false
# SEED_ALLOW_PRODUCTION=true

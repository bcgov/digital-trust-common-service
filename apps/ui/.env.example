# Dev-only: where the Vite dev-server proxy forwards /api, /oidc and /health.
# Mirrors the production Caddy reverse proxy — the SPA itself only uses
# relative URLs, so there is no VITE_API_URL and one build works everywhere.
VITE_PROXY_TARGET=http://localhost:3000

# Auth mode for the AuthProvider seam:
#   mock — fake local login, no backend auth required (default)
#   oidc — real Authorization Code + PKCE flow against this origin's /oidc
#          provider, which federates to Keycloak internally
VITE_AUTH_MODE=mock

# --- oidc mode only -------------------------------------------------------
# Reach the app through the Caddy front door (https://app.localhost), not the
# raw Vite origin: OIDC_ISSUER is https://app.localhost/oidc and every
# endpoint in the discovery document points there, so http://localhost:5173
# would put authorize/token cross-origin and drop the provider's session
# cookie. See docs/DEVELOPER.md.
#
# The client_id and scopes the SPA presents are not env vars: they differ
# between deployments, so they are read at runtime from /config.json —
# public/config.json here, the chart's frontend.config.* in Kubernetes.

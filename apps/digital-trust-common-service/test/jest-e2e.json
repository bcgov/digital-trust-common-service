{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "setupFilesAfterEnv": ["<rootDir>/jest-e2e-setup.ts"],
  "testRegex": ".e2e-spec.ts$",
  "maxWorkers": 1,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(jose|oidc-provider|openid-client|oauth4webapi|quick-lru|nanoid|eta|jsesc|raw-body|@nestjs/terminus)/)"
  ],
  "moduleNameMapper": {
    "^@app/common(|/.*)$": "<rootDir>/../../../libs/common/src/$1",
    "^@app/database(|/.*)$": "<rootDir>/../../../libs/database/src/$1",
    "^@app/auth(|/.*)$": "<rootDir>/../../../libs/auth/src/$1",
    "^@app/pg-boss(|/.*)$": "<rootDir>/../../../libs/pg-boss/src/$1",
    "^@app/credential-ports(|/.*)$": "<rootDir>/../../../libs/credential-ports/src/$1",
    "^@app/oidc(|/.*)$": "<rootDir>/../../../libs/oidc/src/$1"
  }
}

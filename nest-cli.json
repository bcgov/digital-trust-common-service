{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/digital-trust-common-service",
  "sourceRoot": "apps/digital-trust-common-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/digital-trust-common-service/tsconfig.app.json"
  },
  "projects": {
    "auth": {
      "type": "library",
      "root": "libs/auth",
      "entryFile": "index",
      "sourceRoot": "libs/auth/src",
      "compilerOptions": {
        "tsConfigPath": "libs/auth/tsconfig.lib.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "credential-ports": {
      "type": "library",
      "root": "libs/credential-ports",
      "entryFile": "index",
      "sourceRoot": "libs/credential-ports/src",
      "compilerOptions": {
        "tsConfigPath": "libs/credential-ports/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "digital-trust-common-service": {
      "type": "application",
      "root": "apps/digital-trust-common-service",
      "entryFile": "main",
      "sourceRoot": "apps/digital-trust-common-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/digital-trust-common-service/tsconfig.app.json"
      }
    },
    "oidc": {
      "type": "library",
      "root": "libs/oidc",
      "entryFile": "index",
      "sourceRoot": "libs/oidc/src",
      "compilerOptions": {
        "tsConfigPath": "libs/oidc/tsconfig.lib.json"
      }
    }
  }
}
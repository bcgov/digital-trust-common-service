# Same-origin front door for local dev: SPA + /oidc + /api on one HTTPS
# origin, mirroring the production topology (IN-15 / #160).
app.localhost {
    tls internal

    # API paths go to the app (host `npm run start:dev` or the compose `app`
    # service, which publishes 3000 either way).
    @api path /api/* /oidc/* /health/*
    handle @api {
        reverse_proxy host.docker.internal:3000
    }

    # Everything else goes to the Vite dev server (host `npm run dev` or the
    # compose `ui` service, which publishes 5173 either way).
    handle {
        reverse_proxy host.docker.internal:5173
    }
}

keycloak.localhost {
    tls internal

    reverse_proxy keycloak:8080
}

# Grafana from the local observability stack (`docker compose --profile obs up
# -d lgtm`). Also published directly on http://localhost:3001, so this block is
# a convenience, not the only way in. Returns 502 while the `obs` profile is
# down.
grafana.localhost {
    tls internal

    reverse_proxy lgtm:3000
}
